#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <180>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <125>;
};

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | Unlock |
            // | CAPS |  A  |  S  |  D  |  F  |  G  |  LALT | GAME |  H  |  J   |  K  |  L  |  ;  | KWin |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | OSWin |
            //                    | ESC/L4 | SPC | TAB |            | ENT/L2 | BSPC/L1 | DEL |

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E      &kp R      &kp T    &kp C_MUTE  &kp C_PP  &kp Y      &kp U       &kp I      &kp O    &kp P     &studio_unlock
&kp CAPS   &kp A  &kp S  &kp D      &kp F      &kp G    &kp LALT    &mo 3     &kp H      &kp J       &kp K      &kp L    &kp SEMI  &kp LC(LS(GRAVE))
&kp LSHFT  &kp Z  &kp X  &kp C      &kp V      &kp B                          &kp N      &kp M       &kp COMMA  &kp DOT  &kp FSLH  &kp LG(GRAVE)
                         &lt 4 ESC  &kp SPACE  &kp TAB                        &lt 2 RET  &lt 1 BSPC  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        Number {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |      |  [  |  7  |  8  |  9  |  ]   |        |       |      |      |     |     |     |      |
            // |      |  ;  |  4  |  5  |  6  |  =   |        |       | LFT  | DWN  | UP  | RGT |     |      |
            // |      |  `  |  1  |  2  |  3  |  \   |        |       |      |      |     |     |     |      |
            //                    |  .  |  0  |  -    |        | ENT   | BSPC| DEL |

            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT   &trans  &trans  &trans   &trans      &trans             &trans         &trans             &trans
&trans  &kp SEMI   &kp N4  &kp N5  &kp N6  &kp EQUAL  &trans  &trans  &none    &kp LSHIFT  &kp RIGHT_COMMAND  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &trans
&trans  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH                   &trans   &trans      &trans             &trans         &trans             &trans
                           &none   &kp N0  &kp SLASH                  &kp RET  &kp BSPC    &none
            >;
        };

        Symbol {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |      | F1  | F2  | F3  | F4  | F5  | LCTRL | RCTRL |      |      |      |      |     |      |
            // |      | F6  | F7  | F8  | F9  | F10 |  LALT | RALT  | CAPS | SHFT | CTRL | ALT  | CMD |      |
            // |      | F11 | F12 |     |     |     |               |      |      |      |      |     |      |
            //                    | ESC | SPC | TAB |               | ENT |     | DEL |

            bindings = <
&trans  &kp F1   &kp F2   &kp F3   &kp F4     &kp F5   &kp LCTRL  &kp RCTRL  &trans   &trans     &trans             &trans         &trans             &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9     &kp F10  &kp LALT   &kp RALT   &none    &kp RSHFT  &kp RIGHT_COMMAND  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &trans
&trans  &kp F11  &kp F12  &trans   &trans     &trans                         &trans   &trans     &trans             &trans         &trans             &trans
                          &kp ESC  &kp SPACE  &kp TAB                        &kp RET  &trans     &kp DEL
            >;
        };

        Gaming {
            display-name = "GAMING";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R      &kp T   &trans  &trans  &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &trans  &trans
&kp LEFT_SHIFT  &kp A  &kp S  &kp D         &kp F      &kp G   &trans  &trans  &kp H       &trans             &trans           &trans      &trans  &trans
&kp LEFT_GUI    &kp Z  &kp X  &kp C         &kp V      &none                   &trans      &trans             &trans           &trans      &trans  &trans
                              &kp LEFT_ALT  &kp SPACE  &trans                  &trans      &trans             &trans
            >;
        };

        Controls {
            display-name = "CONTROLS";

            // -----------------------------------------------------------------------------------------
            // |      |     |     |     |     |     |       |       | PREV | VOLD | VOLU | NEXT | PP  | BT1  |
            // |      |     |     |     |     |     |       |       | Tab1 | Tab2 | Tab3 | Tab4 |     | BT2  |
            // |      |     |     |     |     |     |               | Tab5 | Tab6 | Tab7 | Tab8 |     | BT3  |
            //                    |     |     |     |               |     |     |     |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp C_PREV      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT      &kp C_PP  &bt BT_SEL 0
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(LA(N1))  &kp LC(LA(N2))  &kp LC(LA(N3))  &kp LC(LA(N4))  &trans    &bt BT_SEL 1
&trans  &trans  &trans  &trans  &trans  &trans                  &kp LC(LA(N5))  &kp LC(LA(N6))  &kp LC(LA(N7))  &kp LC(LA(N8))  &trans    &bt BT_SEL 2
                        &trans  &trans  &trans                  &trans          &trans          &trans
            >;
        };
    };
};
