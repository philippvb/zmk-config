#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT 0
#define NUMBER 1
#define SYMBOL 2
#define GAMING 3
#define CONTROLS 4
#define KITTY 5

&mt {
    flavor = "balanced";
    tapping-term-ms = <180>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <125>;
};

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | GAME |
            // | CAPS | A/CTL | S/ALT | D/CMD | F/SFT |  G  |  LALT |      |  H  | J/SFT | K/CMD | L/ALT | ;/CTL | KWin |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  -  | OSWin |
            //                    | ESC/L5 | SPC | TAB/L4 |        | ENT/L1 | BSPC/L2 | DEL |

            bindings = <
&kp TAB    &kp Q        &kp W       &kp E               &kp R         &kp T      &kp C_MUTE  &kp C_PP  &kp Y      &kp U        &kp I                &kp O            &kp P                   &to GAMING
&kp CAPS   &mt LCTRL A  &mt LALT S  &mt LEFT_COMMAND D  &mt LSHIFT F  &kp G      &kp LALT    &none     &kp H      &mt RSHFT J  &mt RIGHT_COMMAND K  &mt RIGHT_ALT L  &mt RIGHT_CONTROL SEMI  &kp LC(LS(GRAVE))
&kp LSHFT  &kp Z        &kp X       &kp C               &kp V         &kp B                            &kp N      &kp M        &kp COMMA            &kp DOT          &kp MINUS               &kp LG(GRAVE)
                                    &kp ESCAPE          &lt 5 SPACE   &lt 4 TAB                        &lt 1 RET  &lt 2 BSPC   &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        Number {
            display-name = "NUMBER";

            // -----------------------------------------------------------------------------------------
            // |      |  [  |  7  |  8  |  9  |  ]   |        |       |      |      |      |      |      |      |
            // |      |  ;  |  4  |  5  |  6  |  =   |        |       |      | SHFT | CMD  | ALT  | CTRL |      |
            // |      |  `  |  1  |  2  |  3  |  \   |        |       |      |      |      |      |      |      |
            //                    |     |  0  |  /    |        | ENT   | BSPC |     |

            bindings = <
&none  &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT   &none  &none  &none    &none       &none              &none          &none              &none
&none  &kp SEMI   &kp N4  &kp N5  &kp N6  &kp EQUAL  &none  &none  &none    &kp LSHIFT  &kp RIGHT_COMMAND  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &none
&none  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH                 &none    &none       &none              &none          &none              &none
                          &none   &kp N0  &kp SLASH                &kp RET  &kp BSPC    &kp DELETE
            >;
        };

        Symbol {
            display-name = "SYMBOL";

            // -----------------------------------------------------------------------------------------
            // |      | F12 | F7  | F8  | F9  |      | LCTRL | RCTRL |      |      |      |      |      |      |
            // |      | F11 | F4  | F5  | F6  |      |  LALT | RALT  |      | SHFT | CMD  | ALT  | CTRL |      |
            // |      | F10 | F1  | F2  | F3  |      |               |      |      |      |      |      |      |
            //                    | ESC | SPC | TAB |               | ENT |     | DEL |

            bindings = <
&none  &kp F12  &kp F7  &kp F8   &kp F9     &none    &kp LCTRL  &kp RCTRL  &none    &none          &none              &none          &none              &none
&none  &kp F11  &kp F4  &kp F5   &kp F6     &none    &kp LALT   &kp RALT   &none    &kp RSHFT      &kp RIGHT_COMMAND  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &none
&none  &kp F10  &kp F1  &kp F2   &kp F3     &none                          &none    &none          &none              &none          &none              &none
                        &kp ESC  &kp SPACE  &kp TAB                        &kp RET  &kp BACKSPACE  &kp DEL
            >;
        };

        Gaming {
            display-name = "GAMING";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E         &kp R      &kp T  &none  &none  &kp C_PREV  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &none  &to DEFAULT
&kp LEFT_SHIFT  &kp A  &kp S  &kp D         &kp F      &kp G  &none  &none  &kp H       &none              &none            &none       &none  &none
&kp LEFT_GUI    &kp Z  &kp X  &kp C         &kp V      &none                &none       &none              &none            &none       &none  &none
                              &kp LEFT_ALT  &kp SPACE  &none                &none       &none              &none
            >;
        };

        Controls {
            display-name = "CONTROLS";

            // -----------------------------------------------------------------------------------------
            // | RGB  |     |     |     |     |     |       |       | PREV | VOLD | VOLU | NEXT | PP  | BT1  |
            // |      |     |     |     |     |     |       |       |      | LFT  | DWN  |  UP  | RGT | BT2  |
            // |      |     |     |     |     |     |               |      |      |      |      |     | BT3  |
            //                    |     |     |     |               |     |     |     |

            bindings = <
&rgb_ug RGB_TOG  &none  &none  &none  &none  &none  &none  &none  &kp C_PREV  &kp C_VOL_DN   &kp C_VOL_UP  &kp C_NEXT  &kp C_PP  &bt BT_SEL 0
&none            &none  &none  &none  &none  &none  &none  &none  &kp LEFT    &kp DOWN       &kp UP_ARROW  &kp RIGHT   &none     &bt BT_SEL 1
&none            &none  &none  &none  &none  &none                &none       &none          &none         &none       &none     &bt BT_SEL 2
                               &none  &none  &none                &kp ENTER   &kp BACKSPACE  &kp DELETE
            >;
        };

        KittyTabs {
            display-name = "KITTY";

            // -----------------------------------------------------------------------------------------
            // |      |     |     |     |     |     |       |       |      | Tab1 | Tab2 | Tab3 | Tab4 | KWin |
            // |      |     |     |     |     |     |       |       |      | Cmd1 | Cmd2 | Cmd3 | Cmd4 | OSWin |
            // |      |     |     |     |     |     |               |      | Cmd5 | Cmd6 | Cmd7 | Cmd8 |      |
            //                    |     |     |     |               |     |     |     |

            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none      &kp LC(LA(N1))  &kp LC(LA(N2))  &kp LC(LA(N3))  &kp LC(LA(N4))  &kp LC(LS(GRAVE))
&none  &none  &none  &none  &none  &none  &none  &none  &none      &kp LG(N1)      &kp LG(N2)      &kp LG(N3)      &kp LG(N4)      &kp LG(GRAVE)
&none  &none  &none  &none  &none  &none                &none      &kp LG(N5)      &kp LG(N6)      &kp LG(N7)      &kp LG(N8)      &none
                     &none  &none  &none                &kp ENTER  &kp BACKSPACE   &kp DELETE
            >;
        };
    };
};
